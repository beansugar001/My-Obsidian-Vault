# V109D2 independent read-only verification after V109D validation mismatch.
set ::v109d2_status "INCOMPLETE_OR_UNKNOWN"; set ::v109d2_halt_count 0
proc v109d2_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]]; if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"}; scan $x %x v; return [expr {$v&0xffffffff}]}
proc v109d2_dw {r v label} {echo [format "V109D2_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]]; riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v109d2_sb {label} {set s [v109d2_dr 0x38]; echo [format "V109D2_SBCS label=%s value=0x%08X" $label $s]; if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"}; return $s}
proc v109d2_rd {a label} {v109d2_sb "${label}_BEFORE"; v109d2_dw 0x38 0x20140404 "${label}_READ_MODE"; v109d2_sb "${label}_MODE"; v109d2_dw 0x39 $a "${label}_ADDRESS"; set v [v109d2_dr 0x3c]; v109d2_sb "${label}_AFTER"; echo [format "V109D2_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v]; return $v}
proc v109d2_trip {a label} {set x [v109d2_rd $a "${label}_1"]; sleep 10; set y [v109d2_rd $a "${label}_2"]; sleep 10; set z [v109d2_rd $a "${label}_3"]; echo [format "V109D2_TRIPLET label=%s values=%08X,%08X,%08X" $label $x $y $z]; if {$x!=$y||$y!=$z} {error "UNSTABLE_READ $label"}; return $x}
set rc [catch {
 set il [capture {init}]; echo "V109D2_INIT_BEGIN"; echo $il; echo "V109D2_INIT_END"; if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"}; if {[jtag names] ne "riscv.cpu" || ![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"}; if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate]; echo "V109D2_CPU_INITIAL=$cpu"; if {$cpu eq "running"} {set h [capture {halt 2000}]; incr ::v109d2_halt_count; echo "V109D2_HALT=$h"; set cpu [riscv.cpu curstate]}; echo "V109D2_CPU_FINAL=$cpu"; if {$cpu ne "halted"||$::v109d2_halt_count>1} {error "HALT_FAILED"}; set dm [v109d2_dr 0x11]; echo [format "V109D2_DMSTATUS=0x%08X" $dm]; if {($dm&0x300)!=0x300||($dm&0xc00)!=0} {error "DMSTATUS_NOT_HALTED"}; v109d2_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_ODR 0x40000100 0xC GPIOB_DIR 0x40000104 0xC GPIOB_OSOD 0x40000158 0xC GPIOB_AFR1 0x40000168 0x6C0 GPIOB_IDR 0x40000150 0x2C CLK_DIV0 0x40002810 0x20 CLK_DIV1 0x40002814 0x30 MODE 0x40002820 1 ADDR 0x40002824 0x3C MCTR 0x40002828 2 HOLD 0x40002838 5 STATUS 0x4000283C 0 RAW_INTR_STA 0x40002858 0 FIFO_STA 0x4000280C 5} {set v [v109d2_rd $a $label]; if {$v!=$exp} {error "MISMATCH $label expected=[format 0x%08X $exp] got=[format 0x%08X $v]"}}
 set m [v109d2_trip 0x40002800 MODULE_CTRL]; if {($m&0xD)!=0xC || ($m&1)!=0 || ($m&2)!=2} {error "MODULE_CTRL_ENABLE_BITS_WRONG"}; set ::v109d2_status "PASS_FIFO_ENABLED_I2C_DISABLED_STABLE"
} err]; if {$rc} {set ::v109d2_status "FAIL_OR_UNKNOWN"; echo "V109D2_ERROR=$err"}; set sf [catch {v109d2_sb FINAL} sv]; echo [format "V109D2_FINAL_SBCS rc=%d value=%s" $sf $sv]; set df [catch {v109d2_dr 0x11} dv]; echo [format "V109D2_FINAL_DMSTATUS rc=%d value=%s" $df $dv]; echo [format "V109D2_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=0" $::v109d2_status $::v109d2_halt_count]; echo "V109D2_COMPLETE"; shutdown