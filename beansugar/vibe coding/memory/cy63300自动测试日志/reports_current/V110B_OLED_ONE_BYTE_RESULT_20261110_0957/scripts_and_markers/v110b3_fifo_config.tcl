# V110B3: ARM-order controller configuration, FIFO enable only; I2C_EN remains 0.
set ::v110b3_status "INCOMPLETE_OR_UNKNOWN"; set ::v110b3_write_count 0; set ::v110b3_halt_count 0
proc v110b3_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]]; if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"}; scan $x %x v; return [expr {$v&0xffffffff}]}
proc v110b3_dw {r v label} {echo [format "V110B3_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]]; riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v110b3_sb {label} {set s [v110b3_dr 0x38]; echo [format "V110B3_SBCS label=%s value=0x%08X" $label $s]; if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"}; return $s}
proc v110b3_rd {a label} {v110b3_sb "${label}_BEFORE"; v110b3_dw 0x38 0x20140404 "${label}_READ_MODE"; v110b3_sb "${label}_MODE"; v110b3_dw 0x39 $a "${label}_ADDRESS"; set v [v110b3_dr 0x3c]; v110b3_sb "${label}_AFTER"; echo [format "V110B3_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v]; return $v}
proc v110b3_wr {a v label} {v110b3_sb "${label}_PRE"; v110b3_dw 0x38 0x20040404 "${label}_WRITE_MODE"; v110b3_sb "${label}_MODE_IDLE"; v110b3_dw 0x39 $a "${label}_ADDRESS"; v110b3_sb "${label}_ADDRESS_IDLE"; incr ::v110b3_write_count; echo [format "V110B3_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d label=%s" $a $v $::v110b3_write_count $label]; v110b3_dw 0x3c $v "${label}_TARGET"; set done 0; for {set i 0} {$i<50} {incr i} {set s [v110b3_dr 0x38]; echo [format "V110B3_WRITE_POLL_%s_%02d=0x%08X" $label $i $s]; if {$s&0x00407000} {error "SBA_WRITE_ERROR $label"}; if {($s&0x00200000)==0} {set done 1; break}; sleep 1}; if {!$done} {error "SBA_WRITE_TIMEOUT $label"}; set got [v110b3_rd $a "${label}_VERIFY"]; if {(($a == 0x40002800) && (($got & 0xD) != ($v & 0xD))) || (($a != 0x40002800) && $got != $v)} {error "READBACK_MISMATCH $label expected=[format 0x%08X $v] got=[format 0x%08X $got]"}; return $got}
set rc [catch {
 set il [capture {init}]; echo "V110B3_INIT_BEGIN"; echo $il; echo "V110B3_INIT_END"; if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"}; if {[jtag names] ne "riscv.cpu" || ![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"}; if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate]; echo "V110B3_CPU_INITIAL=$cpu"; if {$cpu eq "running"} {set h [capture {halt 2000}]; incr ::v110b3_halt_count; echo "V110B3_HALT=$h"; set cpu [riscv.cpu curstate]}; echo "V110B3_CPU_FINAL=$cpu"; if {$cpu ne "halted" || $::v110b3_halt_count>1} {error "HALT_FAILED"}; set dm [v110b3_dr 0x11]; echo [format "V110B3_DMSTATUS=0x%08X" $dm]; if {($dm&0x300)!=0x300 || ($dm&0xc00)!=0} {error "DMSTATUS_NOT_HALTED"}; v110b3_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_ODR 0x40000100 0xC GPIOB_DIR 0x40000104 0xC GPIOB_OSOD 0x40000158 0xC GPIOB_AFR1 0x40000168 0x6C0 GPIOB_IDR 0x40000150 0x2C MODULE_CTRL 0x40002800 2 FIFO_STA 0x4000280C 5 CLK_DIV0 0x40002810 0x20 CLK_DIV1 0x40002814 0x30 MODE 0x40002820 1 ADDR 0x40002824 0x133 MCTR 0x40002828 0 HOLD 0x40002838 5 STATUS 0x4000283C 0} {set got [v110b3_rd $a $label]; if {$got!=$exp} {error "PRECONDITION_MISMATCH $label exp=[format 0x%08X $exp] got=[format 0x%08X $got]"}}
 v110b3_wr 0x40002828 0x00000002 MCTR_STOP_ON_TX_EMPTY
 v110b3_wr 0x40002824 0x0000003C OLED_7BIT_ADDRESS
 v110b3_wr 0x40002800 0x0000000C TX_RX_FIFO_ENABLE_ONLY
 set module [v110b3_rd 0x40002800 MODULE_CTRL_POST]; if {$module!=0xE} {error "MODULE_CTRL_EXPECTED_FIFO_ONLY_0E"}; set fifo [v110b3_rd 0x4000280C FIFO_STA_POST]; if {$fifo!=5} {error "FIFO_NOT_EMPTY_OR_STATUS_CHANGED"}; set st [v110b3_rd 0x4000283C STATUS_POST]; if {$st!=0} {error "CONTROLLER_NOT_IDLE"}; set ::v110b3_status "PASS_CONTROLLER_CONFIG_FIFO_ONLY_I2C_DISABLED"
} err]; if {$rc} {set ::v110b3_status "FAIL_OR_UNKNOWN"; echo "V110B3_ERROR=$err"}; set sf [catch {v110b3_sb FINAL} sv]; echo [format "V110B3_FINAL_SBCS rc=%d value=%s" $sf $sv]; set df [catch {v110b3_dr 0x11} dv]; echo [format "V110B3_FINAL_DMSTATUS rc=%d value=%s" $df $dv]; echo [format "V110B3_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d" $::v110b3_status $::v110b3_halt_count $::v110b3_write_count]; echo "V110B3_COMPLETE"; shutdown