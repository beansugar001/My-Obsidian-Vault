# V109F one-byte I2C probe: single TX FIFO write, no interrupt clear/retry.
set ::v109f_status "INCOMPLETE_OR_UNKNOWN";set ::v109f_wc 0;set ::v109f_hc 0
proc v109f_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]];if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"};scan $x %x v;return [expr {$v&0xffffffff}]}
proc v109f_dw {r v label} {echo [format "V109F_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]];riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v109f_sb {label} {set s [v109f_dr 0x38];echo [format "V109F_SBCS label=%s value=0x%08X" $label $s];if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"};return $s}
proc v109f_rd {a label} {v109f_sb "${label}_BEFORE";v109f_dw 0x38 0x20140404 "${label}_READ_MODE";v109f_sb "${label}_MODE";v109f_dw 0x39 $a "${label}_ADDRESS";set v [v109f_dr 0x3c];v109f_sb "${label}_AFTER";echo [format "V109F_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v];return $v}
set rc [catch {
 set il [capture {init}];echo "V109F_INIT_BEGIN";echo $il;echo "V109F_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V109F_CPU_INITIAL=$cpu";if {$cpu eq "running"} {set h [capture {halt 2000}];incr ::v109f_hc;echo "V109F_HALT=$h";set cpu [riscv.cpu curstate]};echo "V109F_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v109f_hc>1} {error "HALT_FAILED"};set dm [v109f_dr 0x11];echo [format "V109F_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xc00)!=0} {error "DMSTATUS_NOT_HALTED"};v109f_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_IDR 0x40000150 0x2C MODULE_CTRL 0x40002800 0xF FIFO_STA 0x4000280C 5 MODE 0x40002820 1 ADDR 0x40002824 0x3C MCTR 0x40002828 2 STATUS 0x4000283C 0 RAW_INTR_STA 0x40002858 0} {set v [v109f_rd $a $label];if {$v!=$exp} {error "PRECONDITION_MISMATCH $label got=[format 0x%08X $v] expected=[format 0x%08X $exp]"}}
 v109f_sb FIFO_WRITE_PRE;v109f_dw 0x38 0x20040404 FIFO_WRITE_MODE;v109f_sb FIFO_WRITE_MODE_IDLE;v109f_dw 0x39 0x40002808 TX_FIFO_ADDRESS;v109f_sb FIFO_WRITE_ADDRESS_IDLE;incr ::v109f_wc;echo "V109F_TARGET_MMIO_WRITE_ATTEMPT addr=0x40002808 value=0x00000000 count=1 label=OLED_CONTROL_BYTE";v109f_dw 0x3c 0x00000000 OLED_TX_FIFO_BYTE;set done 0
 for {set i 0} {$i<200} {incr i} {set sb [v109f_sb "POST_FIFO_WRITE_$i"];set st [v109f_rd 0x4000283C "STATUS_POLL_$i"];set fs [v109f_rd 0x4000280C "FIFO_STA_POLL_$i"];set raw [v109f_rd 0x40002858 "RAW_INTR_POLL_$i"];set idr [v109f_rd 0x40000150 "GPIOB_IDR_POLL_$i"];echo [format "V109F_POLL i=%d status=0x%08X fifo=0x%08X raw=0x%08X idr=0x%08X" $i $st $fs $raw $idr];if {($raw & 0x1000)!=0 && (($st&0x3)==0)} {set done 1;break};if {($raw & 0x2000)!=0 && (($st&0x3)==0)} {set done 1;break};if {($sb&0x00607000)!=0} {error "SBA_ERROR_DURING_POLL"};sleep 1}
 if {!$done} {error "I2C_TRANSACTION_COMPLETION_NOT_OBSERVED"};set nack [expr {($raw>>13)&1}];set stop [expr {($raw>>12)&1}];set ::v109f_last_raw $raw;set ::v109f_last_status $st;set ::v109f_last_fifo $fs;set ::v109f_last_idr $idr
 if {$nack} {set ::v109f_status "FAIL_ADDRESS_OR_DATA_NACK"} elseif {!$stop} {set ::v109f_status "UNKNOWN_STOP_NOT_SEEN"} elseif {($fs&1)==0} {set ::v109f_status "FAIL_TX_FIFO_NOT_EMPTY"} elseif {($idr&0xC)!=0xC} {set ::v109f_status "FAIL_LINES_NOT_HIGH_AFTER_STOP"} else {set ::v109f_status "PASS_ONE_BYTE_STOP_NO_NACK"}
} err];if {$rc} {set ::v109f_status "FAIL_OR_UNKNOWN";echo "V109F_ERROR=$err"};if {[info exists ::v109f_last_raw]} {echo [format "V109F_FINAL_OBS raw=0x%08X status=0x%08X fifo=0x%08X idr=0x%08X" $::v109f_last_raw $::v109f_last_status $::v109f_last_fifo $::v109f_last_idr]};set sf [catch {v109f_sb FINAL} sv];echo [format "V109F_FINAL_SBCS rc=%d value=%s" $sf $sv];set df [catch {v109f_dr 0x11} dv];echo [format "V109F_FINAL_DMSTATUS rc=%d value=%s" $df $dv];echo [format "V109F_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d" $::v109f_status $::v109f_hc $::v109f_wc];echo "V109F_COMPLETE";shutdown