# V109E2 read-only state verification after I2C_EN write.
set ::v109e2_status "INCOMPLETE_OR_UNKNOWN"; set ::v109e2_hc 0
proc v109e2_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]];if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"};scan $x %x v;return [expr {$v&0xffffffff}]}
proc v109e2_dw {r v label} {echo [format "V109E2_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]];riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v109e2_sb {label} {set s [v109e2_dr 0x38];echo [format "V109E2_SBCS label=%s value=0x%08X" $label $s];if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"};return $s}
proc v109e2_rd {a label} {v109e2_sb "${label}_BEFORE";v109e2_dw 0x38 0x20140404 "${label}_READ_MODE";v109e2_sb "${label}_MODE";v109e2_dw 0x39 $a "${label}_ADDRESS";set v [v109e2_dr 0x3c];v109e2_sb "${label}_AFTER";echo [format "V109E2_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v];return $v}
set rc [catch {
 set il [capture {init}];echo "V109E2_INIT_BEGIN";echo $il;echo "V109E2_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V109E2_CPU_INITIAL=$cpu";if {$cpu eq "running"} {set h [capture {halt 2000}];incr ::v109e2_hc;echo "V109E2_HALT=$h";set cpu [riscv.cpu curstate]};echo "V109E2_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v109e2_hc>1} {error "HALT_FAILED"};set dm [v109e2_dr 0x11];echo [format "V109E2_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xc00)!=0} {error "DMSTATUS_NOT_HALTED"};v109e2_sb PREFLIGHT
 set m [v109e2_rd 0x40002800 MODULE_CTRL];set f [v109e2_rd 0x4000280C FIFO_STA];set s [v109e2_rd 0x4000283C STATUS];set raw [v109e2_rd 0x40002858 RAW_INTR_STA];set idr [v109e2_rd 0x40000150 GPIOB_IDR];set cl [v109e2_rd 0x4002180C PERI_CLKEN];set rst [v109e2_rd 0x40021810 PERI_RST]
 echo [format "V109E2_MODULE_BITS i2c_en=%d tx_fifo_en=%d rx_fifo_en=%d reserved1=%d" [expr {$m&1}] [expr {($m>>2)&1}] [expr {($m>>3)&1}] [expr {($m>>1)&1}]]
 if {($m&0xD)!=0xD||($m&2)!=2||$f!=5||$s!=0||$raw!=0||($idr&0xC)!=0xC||$cl!=0x21||$rst!=0} {error "POST_ENABLE_STATE_NOT_IDLE_OR_LINE_LOW"};set ::v109e2_status "PASS_I2C_EN_ON_IDLE_FIFO_EMPTY_LINES_HIGH"
} err];if {$rc} {set ::v109e2_status "FAIL_OR_UNKNOWN";echo "V109E2_ERROR=$err"};set sf [catch {v109e2_sb FINAL} sv];echo [format "V109E2_FINAL_SBCS rc=%d value=%s" $sf $sv];set df [catch {v109e2_dr 0x11} dv];echo [format "V109E2_FINAL_DMSTATUS rc=%d value=%s" $df $dv];echo [format "V109E2_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=0" $::v109e2_status $::v109e2_hc];echo "V109E2_COMPLETE";shutdown