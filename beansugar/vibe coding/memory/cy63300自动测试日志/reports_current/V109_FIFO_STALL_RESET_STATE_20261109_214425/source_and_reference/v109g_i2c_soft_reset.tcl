# V109G: one controlled I2C peripheral reset assert/release to recover stalled single-byte TX.
set ::v109g_status "INCOMPLETE_OR_UNKNOWN";set ::v109g_wc 0;set ::v109g_hc 0
proc v109g_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]];if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"};scan $x %x v;return [expr {$v&0xffffffff}]}
proc v109g_dw {r v label} {echo [format "V109G_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]];riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v109g_sb {label} {set s [v109g_dr 0x38];echo [format "V109G_SBCS label=%s value=0x%08X" $label $s];if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"};return $s}
proc v109g_rd {a label} {v109g_sb "${label}_BEFORE";v109g_dw 0x38 0x20140404 "${label}_READ_MODE";v109g_sb "${label}_MODE";v109g_dw 0x39 $a "${label}_ADDRESS";set v [v109g_dr 0x3c];v109g_sb "${label}_AFTER";echo [format "V109G_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v];return $v}
proc v109g_wr {a v label} {v109g_sb "${label}_PRE";v109g_dw 0x38 0x20040404 "${label}_WRITE_MODE";v109g_sb "${label}_MODE_IDLE";v109g_dw 0x39 $a "${label}_ADDRESS";v109g_sb "${label}_ADDRESS_IDLE";incr ::v109g_wc;echo [format "V109G_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d label=%s" $a $v $::v109g_wc $label];v109g_dw 0x3c $v "${label}_TARGET";set done 0;for {set i 0} {$i<50} {incr i} {set s [v109g_dr 0x38];echo [format "V109G_WRITE_POLL_%s_%02d=0x%08X" $label $i $s];if {$s&0x00407000} {error "SBA_WRITE_ERROR $label"};if {($s&0x00200000)==0} {set done 1;break};sleep 1};if {!$done} {error "SBA_WRITE_TIMEOUT $label"};set got [v109g_rd $a "${label}_VERIFY"];if {$got!=$v} {error "READBACK_MISMATCH $label expected=[format 0x%08X $v] got=[format 0x%08X $got]"};return $got}
set rc [catch {
 set il [capture {init}];echo "V109G_INIT_BEGIN";echo $il;echo "V109G_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V109G_CPU_INITIAL=$cpu";if {$cpu eq "running"} {set h [capture {halt 2000}];incr ::v109g_hc;echo "V109G_HALT=$h";set cpu [riscv.cpu curstate]};echo "V109G_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v109g_hc>1} {error "HALT_FAILED"};set dm [v109g_dr 0x11];echo [format "V109G_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xc00)!=0} {error "DMSTATUS_NOT_HALTED"};v109g_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 MODULE_CTRL 0x40002800 0xF FIFO_STA 0x4000280C 0x104 STATUS 0x4000283C 1 RAW_INTR_STA 0x40002858 0 GPIOB_IDR 0x40000150 0x2C} {set v [v109g_rd $a $label];if {$v!=$exp} {error "PRECONDITION_MISMATCH $label got=[format 0x%08X $v] expected=[format 0x%08X $exp]"}}
 v109g_wr 0x40021810 0x00000020 I2C_SOFT_RESET_ASSERT;sleep 10;v109g_wr 0x40021810 0x00000000 I2C_SOFT_RESET_RELEASE
 foreach {label a exp} {PERI_CLKEN_POST 0x4002180C 0x21 PERI_RST_POST 0x40021810 0 MODULE_CTRL_POST 0x40002800 2 FIFO_STA_POST 0x4000280C 5 STATUS_POST 0x4000283C 0 RAW_INTR_STA_POST 0x40002858 0 CLK_DIV0_POST 0x40002810 0x20 CLK_DIV1_POST 0x40002814 0x30 MODE_POST 0x40002820 1 GPIOB_IDR_POST 0x40000150 0x2C} {set v [v109g_rd $a $label];if {$v!=$exp} {error "POSTRESET_MISMATCH $label got=[format 0x%08X $v] expected=[format 0x%08X $exp]"}}
 set ::v109g_status "PASS_I2C_SOFT_RESET_FIFO_EMPTY_IDLE"
} err];if {$rc} {set ::v109g_status "FAIL_OR_UNKNOWN";echo "V109G_ERROR=$err"};set sf [catch {v109g_sb FINAL} sv];echo [format "V109G_FINAL_SBCS rc=%d value=%s" $sf $sv];set df [catch {v109g_dr 0x11} dv];echo [format "V109G_FINAL_DMSTATUS rc=%d value=%s" $df $dv];echo [format "V109G_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d" $::v109g_status $::v109g_hc $::v109g_wc];echo "V109G_COMPLETE";shutdown