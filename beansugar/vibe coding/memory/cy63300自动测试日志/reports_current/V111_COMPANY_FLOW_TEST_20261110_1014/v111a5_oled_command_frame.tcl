# V111A5: company-flow OLED command frame with manual STOP after observed TX consumption.
set ::v111a5_status "INCOMPLETE_OR_UNKNOWN"; set ::v111a5_wc 0; set ::v111a5_hc 0
proc v111a5_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]]; if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"}; scan $x %x v; return [expr {$v & 0xffffffff}]}
proc v111a5_dw {r v label} {echo [format "V111A5_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v & 0xffffffff}]]; riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v & 0xffffffff}]]}
proc v111a5_sb {label} {set s [v111a5_dr 0x38]; echo [format "V111A5_SBCS label=%s value=0x%08X" $label $s]; if {$s & 0x00607000} {error "SBA_BUSY_OR_ERROR $label"}; return $s}
proc v111a5_rd {a label} {v111a5_sb "${label}_PRE"; v111a5_dw 0x38 0x20140404 "${label}_READ_MODE"; v111a5_sb "${label}_MODE"; v111a5_dw 0x39 $a "${label}_ADDRESS"; set v [v111a5_dr 0x3c]; v111a5_sb "${label}_DONE"; echo [format "V111A5_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v]; return $v}
proc v111a5_mmio_write {a v label verify} {v111a5_sb "${label}_PRE"; v111a5_dw 0x38 0x20040404 "${label}_WRITE_MODE"; v111a5_sb "${label}_MODE"; v111a5_dw 0x39 $a "${label}_ADDRESS"; v111a5_sb "${label}_ADDRESS_IDLE"; incr ::v111a5_wc; echo [format "V111A5_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d label=%s" $a $v $::v111a5_wc $label]; v111a5_dw 0x3c $v "${label}_DATA"; set done 0; for {set i 0} {$i < 50} {incr i} {set s [v111a5_dr 0x38]; echo [format "V111A5_SBA_WRITE_WAIT label=%s i=%d sbcs=0x%08X" $label $i $s]; if {$s & 0x00407000} {error "SBA_WRITE_ERROR $label"}; if {($s & 0x00200000) == 0} {set done 1; break}; sleep 1}; if {!$done} {error "SBA_WRITE_TIMEOUT $label"}; if {$verify} {set got [v111a5_rd $a "${label}_VERIFY"]; if {$got != $v} {error "MMIO_READBACK_MISMATCH $label got=[format 0x%08X $got] expected=[format 0x%08X $v]"}}}
set rc [catch {
 set il [capture {init}]; echo "V111A5_INIT_BEGIN"; echo $il; echo "V111A5_INIT_END"; if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"}; if {[jtag names] ne "riscv.cpu" || ![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"}; if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate]; echo "V111A5_CPU_INITIAL=$cpu"; if {$cpu eq "running"} {set h [capture {halt 2000}]; incr ::v111a5_hc; echo "V111A5_HALT=$h"; set cpu [riscv.cpu curstate]}; echo "V111A5_CPU_FINAL=$cpu"; if {$cpu ne "halted" || $::v111a5_hc > 1} {error "HALT_FAILED"}; set dm [v111a5_dr 0x11]; echo [format "V111A5_DMSTATUS=0x%08X" $dm]; if {($dm & 0x300) != 0x300 || ($dm & 0xc00) != 0} {error "DMSTATUS_NOT_HALTED"}; v111a5_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_IDR 0x40000150 0x2C GPIOB_AFR1 0x40000168 0x6C0 MODULE_CTRL 0x40002800 0xF FIFO_STA 0x4000280C 5 CLK_DIV0 0x40002810 0x0F CLK_DIV1 0x40002814 0x23 MODE 0x40002820 1 ADDR 0x40002824 0x3C MCTR 0x40002828 0 HOLD 0x40002838 5 STATUS 0x4000283C 0 RAW_INTR 0x40002858 0} {set got [v111a5_rd $a $label]; if {$got != $exp} {error "PRECONDITION_MISMATCH $label got=[format 0x%08X $got] expected=[format 0x%08X $exp]"}}
 v111a5_mmio_write 0x40002808 0x00000000 OLED_COMMAND_CONTROL_BYTE 0
 v111a5_mmio_write 0x40002808 0x000000AF OLED_DISPLAY_ON_COMMAND 0
 set data_seen 0; set drained 0; set last_status 0; set last_fifo 0; set last_raw 0
 for {set i 0} {$i < 60} {incr i} {set sb [v111a5_sb "TX_POLL_$i"]; set last_status [v111a5_rd 0x4000283C "STATUS_$i"]; set last_fifo [v111a5_rd 0x4000280C "FIFO_$i"]; set last_raw [v111a5_rd 0x40002858 "RAW_$i"]; set idr [v111a5_rd 0x40000150 "IDR_$i"]; if {$last_status & 0x2} {set data_seen 1}; echo [format "V111A5_POLL i=%d status=0x%08X fifo=0x%08X raw=0x%08X idr=0x%08X" $i $last_status $last_fifo $last_raw $idr]; if {$last_raw & 0xE000} {error [format "I2C_ERROR_FLAGS raw=0x%08X" $last_raw]}; if {$data_seen && ((($last_fifo >> 8) & 0xF) == 0)} {set drained 1; break}; sleep 1}
 if {!$drained} {error "TX_FIFO_NOT_DRAINED_WITHIN_LIMIT"}
 echo [format "V111A5_TX_DRAINED status=0x%08X fifo=0x%08X raw=0x%08X" $last_status $last_fifo $last_raw]
 v111a5_mmio_write 0x40002828 0x00000002 MANUAL_STOP_REQUEST 1
 set stop_done 0
 for {set i 0} {$i < 30} {incr i} {set last_status [v111a5_rd 0x4000283C "STOP_STATUS_$i"]; set last_fifo [v111a5_rd 0x4000280C "STOP_FIFO_$i"]; set last_raw [v111a5_rd 0x40002858 "STOP_RAW_$i"]; set idr [v111a5_rd 0x40000150 "STOP_IDR_$i"]; echo [format "V111A5_STOP_POLL i=%d status=0x%08X fifo=0x%08X raw=0x%08X idr=0x%08X" $i $last_status $last_fifo $last_raw $idr]; if {$last_raw & 0xE000} {error [format "I2C_ERROR_AFTER_STOP raw=0x%08X" $last_raw]}; if {($last_status & 1) == 0 && ($last_raw & 0x1000) != 0 && ($last_fifo & 0xF05) == 0x5 && ($idr & 0xC) == 0xC} {set stop_done 1; break}; sleep 1}
 if {!$stop_done} {error "STOP_OR_IDLE_NOT_CONFIRMED"}; set ::v111a5_status "PASS_OLED_COMMAND_FRAME_STOP_NO_ERROR"; echo [format "V111A5_FINAL_OBS status=0x%08X fifo=0x%08X raw=0x%08X idr=0x%08X" $last_status $last_fifo $last_raw $idr]
} err]; if {$rc} {set ::v111a5_status "FAIL_OR_UNKNOWN"; echo "V111A5_ERROR=$err"}; set sf [catch {v111a5_sb FINAL} sv]; echo [format "V111A5_FINAL_SBCS rc=%d value=%s" $sf $sv]; set df [catch {v111a5_dr 0x11} dv]; echo [format "V111A5_FINAL_DMSTATUS rc=%d value=%s" $df $dv]; echo [format "V111A5_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d" $::v111a5_status $::v111a5_hc $::v111a5_wc]; echo "V111A5_COMPLETE"; shutdown
