# V111A4: enable I2C controller only; no FIFO payload or bus command.
set ::v111a4_status "INCOMPLETE_OR_UNKNOWN"; set ::v111a4_wc 0; set ::v111a4_hc 0
proc v111a4_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]]; if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"}; scan $x %x v; return [expr {$v&0xffffffff}]}
proc v111a4_dw {r v label} {echo [format "V111A4_DMI_WRITE label=%s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]]; riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v111a4_sb {label} {set s [v111a4_dr 0x38]; echo [format "V111A4_SBCS label=%s value=0x%08X" $label $s]; if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"}; return $s}
proc v111a4_rd {a label} {v111a4_sb "${label}_BEFORE";v111a4_dw 0x38 0x20140404 "${label}_READ_MODE";v111a4_sb "${label}_MODE";v111a4_dw 0x39 $a "${label}_ADDRESS";set v [v111a4_dr 0x3c];v111a4_sb "${label}_AFTER";echo [format "V111A4_MMIO_READ label=%s addr=0x%08X value=0x%08X" $label $a $v];return $v}
proc v111a4_wr {a v label} {v111a4_sb "${label}_PRE";v111a4_dw 0x38 0x20040404 "${label}_WRITE_MODE";v111a4_sb "${label}_MODE_IDLE";v111a4_dw 0x39 $a "${label}_ADDRESS";v111a4_sb "${label}_ADDRESS_IDLE";incr ::v111a4_wc;echo [format "V111A4_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d label=%s" $a $v $::v111a4_wc $label];v111a4_dw 0x3c $v "${label}_TARGET";set done 0;for {set i 0} {$i<50} {incr i} {set s [v111a4_dr 0x38];echo [format "V111A4_WRITE_POLL_%02d=0x%08X" $i $s];if {$s&0x00407000} {error "SBA_WRITE_ERROR"};if {($s&0x00200000)==0} {set done 1;break};sleep 1};if {!$done} {error "SBA_WRITE_TIMEOUT"};set got [v111a4_rd $a "${label}_VERIFY"];if {($got & 0xD) != ($v & 0xD)} {error "READBACK_MISMATCH expected=[format 0x%08X $v] got=[format 0x%08X $got]"};return $got}
set rc [catch {
 set il [capture {init}];echo "V111A4_INIT_BEGIN";echo $il;echo "V111A4_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $il]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $il]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $il]} {error "PROBE_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V111A4_CPU_INITIAL=$cpu";if {$cpu eq "running"} {set h [capture {halt 2000}];incr ::v111a4_hc;echo "V111A4_HALT=$h";set cpu [riscv.cpu curstate]};echo "V111A4_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v111a4_hc>1} {error "HALT_FAILED"};set dm [v111a4_dr 0x11];echo [format "V111A4_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xc00)!=0} {error "DMSTATUS_NOT_HALTED"};v111a4_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 CLK_DIV0 0x40002810 0x0F CLK_DIV1 0x40002814 0x23 GPIOB_IDR 0x40000150 0x2C GPIOB_AFR1 0x40000168 0x6C0 MODULE_CTRL 0x40002800 0xE FIFO_STA 0x4000280C 5 MODE 0x40002820 1 MCTR 0x40002828 0 ADDR 0x40002824 0x133 STATUS 0x4000283C 0 RAW_INTR_STA 0x40002858 0} {set x [v111a4_rd $a $label];if {$x!=$exp} {error "PRECONDITION_MISMATCH $label got=[format 0x%08X $x] expected=[format 0x%08X $exp]"}}
 v111a4_wr 0x40002800 0x0000000D I2C_EN_ONLY
 v111a4_wr 0x40002824 0x0000003C OLED_7BIT_ADDRESS
 foreach {label a exp} {MODULE_CTRL_POST 0x40002800 0xF FIFO_STA_POST 0x4000280C 5 STATUS_POST 0x4000283C 0 RAW_INTR_STA_POST 0x40002858 0 GPIOB_IDR_POST 0x40000150 0x2C ADDR_POST 0x40002824 0x3C} {set x [v111a4_rd $a $label];if {$x!=$exp} {error "POSTCONDITION_MISMATCH $label got=[format 0x%08X $x] expected=[format 0x%08X $exp]"}}
 set ::v111a4_status "PASS_I2C_ENABLED_IDLE_LINES_HIGH"
} err];if {$rc} {set ::v111a4_status "FAIL_OR_UNKNOWN";echo "V111A4_ERROR=$err"};set sf [catch {v111a4_sb FINAL} sv];echo [format "V111A4_FINAL_SBCS rc=%d value=%s" $sf $sv];set df [catch {v111a4_dr 0x11} dv];echo [format "V111A4_FINAL_DMSTATUS rc=%d value=%s" $df $dv];echo [format "V111A4_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d" $::v111a4_status $::v111a4_hc $::v111a4_wc];echo "V111A4_COMPLETE";shutdown

