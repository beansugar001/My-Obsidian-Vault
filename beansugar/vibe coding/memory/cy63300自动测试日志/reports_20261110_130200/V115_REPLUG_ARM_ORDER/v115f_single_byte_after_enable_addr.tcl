# V115F: one OLED payload after the V115E enable-before-address sequence.
set ::v115f_status "INCOMPLETE_OR_UNKNOWN";set ::v115f_wc 0;set ::v115f_hc 0;set ::v115f_stop_count 0
proc v115f_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]];if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"};scan $x %x v;return [expr {$v&0xffffffff}]}
proc v115f_dw {r v label} {if {$r!=0x38&&$r!=0x39&&$r!=0x3C} {error "DMI_SETUP_WRITE_DENIED $r"};echo [format "V115F_DMI_WRITE %s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]];riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v115f_sb {label} {set s [v115f_dr 0x38];echo [format "V115F_SBCS %s=0x%08X" $label $s];if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"};return $s}
proc v115f_rd {a label} {v115f_sb "${label}_PRE";v115f_dw 0x38 0x20140404 "${label}_READMODE";v115f_sb "${label}_MODE";v115f_dw 0x39 $a "${label}_ADDRESS";set v [v115f_dr 0x3C];v115f_sb "${label}_DONE";v115f_dw 0x38 0x20040404 "${label}_IDLE";v115f_sb "${label}_IDLE_CHECK";echo [format "V115F_MMIO_READ %s 0x%08X=0x%08X" $label $a $v];return $v}
proc v115f_wr {a v label} {v115f_sb "${label}_PRE";v115f_dw 0x38 0x20040404 "${label}_WRMODE";v115f_sb "${label}_MODE_IDLE";v115f_dw 0x39 $a "${label}_ADDRESS";v115f_sb "${label}_ADDRESS_IDLE";incr ::v115f_wc;echo [format "V115F_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d" $a $v $::v115f_wc];v115f_dw 0x3C $v "${label}_DATA";set done 0;for {set i 0} {$i<50} {incr i} {set s [v115f_dr 0x38];echo [format "V115F_WRITE_WAIT i=%d sbcs=0x%08X" $i $s];if {$s&0x00407000} {error "SBA_WRITE_ERROR"};if {($s&0x00200000)==0} {set done 1;break};sleep 1};if {!$done} {error "SBA_WRITE_TIMEOUT"}}
set rc [catch {
 set init [capture {init}];echo "V115F_INIT_BEGIN";echo $init;echo "V115F_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $init]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $init]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $init]} {error "DAPLINK_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V115F_CPU_INITIAL=$cpu";if {$cpu eq "running"} {capture {halt 2000};incr ::v115f_hc;set cpu [riscv.cpu curstate]};echo "V115F_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v115f_hc>1} {error "CPU_NOT_HALTED"};set dm [v115f_dr 0x11];echo [format "V115F_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xC00)!=0} {error "DMSTATUS_NOT_HALTED"};v115f_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_ODR 0x40000100 0xC GPIOB_DIR 0x40000104 0xC GPIOB_OSOD 0x40000158 0xC GPIOB_AFR1 0x40000168 0x6C0 GPIOB_IDR 0x40000150 0x2C MODULE_CTRL 0x40002800 0xF FIFO_STA 0x4000280C 5 CLK_DIV0 0x40002810 0x3E7 CLK_DIV1 0x40002814 0x3E7 MODE 0x40002820 1 ADDR 0x40002824 0x3C MCTR 0x40002828 0 HOLD 0x40002838 5 STATUS 0x4000283C 0 RAW_INTR 0x40002858 0} {set got [v115f_rd $a $label];if {$got!=$exp} {error "PRECONDITION_MISMATCH $label exp=[format 0x%08X $exp] got=[format 0x%08X $got]"}}
 # OLED control byte only; the controller generates the target address from ADDR.
 v115f_wr 0x40002808 0x00000000 ONE_CONTROL_BYTE
 set seen_data 0;set drained 0;set nack 0;set lastst 0;set lastfs 0;set lastraw 0
 for {set i 0} {$i<60} {incr i} {set lastst [v115f_rd 0x4000283C "POLL_STATUS_$i"];set lastfs [v115f_rd 0x4000280C "POLL_FIFO_$i"];set lastraw [v115f_rd 0x40002858 "POLL_RAW_$i"];if {$lastst&2} {set seen_data 1};if {$lastraw&0x2000} {set nack 1};if {(($lastfs>>8)&0xF)==0} {set drained 1};echo [format "V115F_POLL i=%d status=0x%08X fifo=0x%08X raw=0x%08X" $i $lastst $lastfs $lastraw];if {$nack||($seen_data&&$drained)} {break};sleep 2}
 if {$nack} {set ::v115f_status "FAIL_NACK_STOP_PENDING";v115f_wr 0x40002828 0x00000002 SINGLE_STOP_AFTER_NACK;incr ::v115f_stop_count} elseif {$seen_data&&$drained} {set ::v115f_status "PASS_TX_CONSUMED_STOP_PENDING";v115f_wr 0x40002828 0x00000002 SINGLE_STOP_AFTER_DATA_DRAIN;incr ::v115f_stop_count} elseif {$drained} {set ::v115f_status "UNKNOWN_FIFO_EMPTY_DATA_NOT_SEEN"} else {set ::v115f_status "FAIL_TX_STALLED_NO_DATA_NO_NACK"}
 if {$::v115f_stop_count>0} {for {set j 0} {$j<40} {incr j} {set lastst [v115f_rd 0x4000283C "STOP_STATUS_$j"];set lastraw [v115f_rd 0x40002858 "STOP_RAW_$j"];echo [format "V115F_STOP_POLL j=%d status=0x%08X raw=0x%08X" $j $lastst $lastraw];if {($lastst&1)==0} {if {$::v115f_status eq "PASS_TX_CONSUMED_STOP_PENDING"} {set ::v115f_status "PASS_TX_CONSUMED_STOP_IDLE"} elseif {$::v115f_status eq "FAIL_NACK_STOP_PENDING"} {set ::v115f_status "FAIL_NACK_STOP_IDLE"};break};sleep 2}}
 set finalmod [v115f_rd 0x40002800 FINAL_MODULE];set finaladdr [v115f_rd 0x40002824 FINAL_ADDR];set finalfifo [v115f_rd 0x4000280C FINAL_FIFO];set finalst [v115f_rd 0x4000283C FINAL_STATUS];set finalraw [v115f_rd 0x40002858 FINAL_RAW];echo [format "V115F_FINAL module=0x%08X addr=0x%08X fifo=0x%08X status=0x%08X raw=0x%08X seen_data=%d drained=%d nack=%d" $finalmod $finaladdr $finalfifo $finalst $finalraw $seen_data $drained $nack]
} err];if {$rc} {set ::v115f_status "FAIL_OR_UNKNOWN";echo "V115F_ERROR=$err"};set sbrc [catch {v115f_sb FINAL} sbv];echo [format "V115F_FINAL_SBCS rc=%d value=%s" $sbrc $sbv];set dmrc [catch {v115f_dr 0x11} dmv];echo [format "V115F_FINAL_DMSTATUS rc=%d value=%s" $dmrc $dmv];echo [format "V115F_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d STOP_WRITE_COUNT=%d" $::v115f_status $::v115f_hc $::v115f_wc $::v115f_stop_count];echo "V115F_COMPLETE";shutdown
