# V115C: configure released open-drain AF3 on Pad8/Pad9 after clock-on reset.
set ::v115c_status "INCOMPLETE_OR_UNKNOWN";set ::v115c_wc 0;set ::v115c_hc 0
proc v115c_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]];if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"};scan $x %x v;return [expr {$v&0xffffffff}]}
proc v115c_dw {r v label} {if {$r!=0x38&&$r!=0x39&&$r!=0x3C} {error "DMI_SETUP_WRITE_DENIED $r"};echo [format "V115C_DMI_WRITE %s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]];riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v115c_sb {label} {set s [v115c_dr 0x38];echo [format "V115C_SBCS %s=0x%08X" $label $s];if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"};return $s}
proc v115c_rd {a label} {v115c_sb "${label}_PRE";v115c_dw 0x38 0x20140404 "${label}_READMODE";v115c_sb "${label}_MODE";v115c_dw 0x39 $a "${label}_ADDR";set v [v115c_dr 0x3C];v115c_sb "${label}_DONE";v115c_dw 0x38 0x20040404 "${label}_IDLE";v115c_sb "${label}_IDLE_CHECK";echo [format "V115C_MMIO_READ %s 0x%08X=0x%08X" $label $a $v];return $v}
proc v115c_wr {a v label} {v115c_sb "${label}_PRE";v115c_dw 0x38 0x20040404 "${label}_WRMODE";v115c_sb "${label}_MODE_IDLE";v115c_dw 0x39 $a "${label}_ADDRESS";v115c_sb "${label}_ADDRESS_IDLE";incr ::v115c_wc;echo [format "V115C_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d" $a $v $::v115c_wc];v115c_dw 0x3C $v "${label}_DATA";set done 0;for {set i 0} {$i<50} {incr i} {set s [v115c_dr 0x38];echo [format "V115C_WRITE_WAIT i=%d sbcs=0x%08X" $i $s];if {$s&0x00407000} {error "SBA_WRITE_ERROR"};if {($s&0x00200000)==0} {set done 1;break};sleep 1};if {!$done} {error "SBA_WRITE_TIMEOUT"};set got [v115c_rd $a "${label}_VERIFY"];if {$got!=$v} {error "READBACK_MISMATCH $label"};return $got}
set rc [catch {
 set init [capture {init}];echo "V115C_INIT_BEGIN";echo $init;echo "V115C_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $init]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $init]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $init]} {error "DAPLINK_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V115C_CPU_INITIAL=$cpu";if {$cpu eq "running"} {capture {halt 2000};incr ::v115c_hc;set cpu [riscv.cpu curstate]};echo "V115C_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v115c_hc>1} {error "CPU_NOT_HALTED"};set dm [v115c_dr 0x11];echo [format "V115C_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xC00)!=0} {error "DMSTATUS_NOT_HALTED"};v115c_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_ODR 0x40000100 0 GPIOB_DIR 0x40000104 0 GPIOB_OSOD 0x40000158 0 GPIOB_AFR1 0x40000168 0 MODULE_CTRL 0x40002800 2 FIFO_STA 0x4000280C 5 STATUS 0x4000283C 0 RAW_INTR 0x40002858 0} {set got [v115c_rd $a $label];if {$got!=$exp} {error "PRECONDITION_MISMATCH $label expected=[format 0x%08X $exp] got=[format 0x%08X $got]"}}
 v115c_wr 0x40000100 0x0000000C GPIOB_ODR_RELEASED
 v115c_wr 0x40000158 0x0000000C GPIOB_OPEN_DRAIN
 v115c_wr 0x40000104 0x0000000C GPIOB_DIR_ENABLE
 v115c_wr 0x40000168 0x000006C0 GPIOB_PAD8_PAD9_AF3
 foreach {label a exp} {GPIOB_ODR 0x40000100 0xC GPIOB_DIR 0x40000104 0xC GPIOB_OSOD 0x40000158 0xC GPIOB_AFR1 0x40000168 0x6C0 GPIOB_IDR 0x40000150 0x2C MODULE_CTRL 0x40002800 2 STATUS 0x4000283C 0} {set got [v115c_rd $a "${label}_POST"];if {$got!=$exp} {error "POSTCONDITION_MISMATCH $label expected=[format 0x%08X $exp] got=[format 0x%08X $got]"}}
 set ::v115c_status "PASS_PAD8_PAD9_RELEASED_AF3"
} err];if {$rc} {set ::v115c_status "FAIL_OR_UNKNOWN";echo "V115C_ERROR=$err"};set sbrc [catch {v115c_sb FINAL} sbv];echo [format "V115C_FINAL_SBCS rc=%d value=%s" $sbrc $sbv];echo [format "V115C_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d" $::v115c_status $::v115c_hc $::v115c_wc];echo "V115C_COMPLETE";shutdown
