# V115D: bounded one-byte I2C attempt in ARM order. No reset/resume/flash.
set ::v115d_status "INCOMPLETE_OR_UNKNOWN";set ::v115d_wc 0;set ::v115d_hc 0;set ::v115d_stop_count 0
proc v115d_dr {r} {set o [capture [format "riscv dmi_read 0x%X" $r]];if {![regexp -nocase {0x([0-9a-f]+)} $o -> x]} {error "DMI_READ_PARSE_FAIL $r <$o>"};scan $x %x v;return [expr {$v&0xffffffff}]}
proc v115d_dw {r v label} {if {$r!=0x38&&$r!=0x39&&$r!=0x3C} {error "DMI_SETUP_WRITE_DENIED $r"};echo [format "V115D_DMI_WRITE %s reg=0x%02X value=0x%08X" $label $r [expr {$v&0xffffffff}]];riscv dmi_write [format "0x%X" $r] [format "0x%X" [expr {$v&0xffffffff}]]}
proc v115d_sb {label} {set s [v115d_dr 0x38];echo [format "V115D_SBCS %s=0x%08X" $label $s];if {$s&0x00607000} {error "SBA_BUSY_OR_ERROR $label"};return $s}
proc v115d_rd {a label} {v115d_sb "${label}_PRE";v115d_dw 0x38 0x20140404 "${label}_READMODE";v115d_sb "${label}_MODE";v115d_dw 0x39 $a "${label}_ADDRESS";set v [v115d_dr 0x3C];v115d_sb "${label}_DONE";v115d_dw 0x38 0x20040404 "${label}_IDLE";v115d_sb "${label}_IDLE_CHECK";echo [format "V115D_MMIO_READ %s 0x%08X=0x%08X" $label $a $v];return $v}
proc v115d_wr {a v label} {v115d_sb "${label}_PRE";v115d_dw 0x38 0x20040404 "${label}_WRMODE";v115d_sb "${label}_MODE_IDLE";v115d_dw 0x39 $a "${label}_ADDRESS";v115d_sb "${label}_ADDRESS_IDLE";incr ::v115d_wc;echo [format "V115D_TARGET_MMIO_WRITE_ATTEMPT addr=0x%08X value=0x%08X count=%d label=%s" $a $v $::v115d_wc $label];v115d_dw 0x3C $v "${label}_DATA";set done 0;for {set i 0} {$i<50} {incr i} {set s [v115d_dr 0x38];echo [format "V115D_WRITE_WAIT %s i=%d sbcs=0x%08X" $label $i $s];if {$s&0x00407000} {error "SBA_WRITE_ERROR $label"};if {($s&0x00200000)==0} {set done 1;break};sleep 1};if {!$done} {error "SBA_WRITE_TIMEOUT $label"};set got [v115d_rd $a "${label}_VERIFY"];if {$a==0x40002800} {if {($got&0xD)!=($v&0xD)} {error "READBACK_MISMATCH $label got=[format 0x%08X $got]"}} elseif {$got!=$v} {error "READBACK_MISMATCH $label got=[format 0x%08X $got]"};return $got}
set rc [catch {
 set init [capture {init}];echo "V115D_INIT_BEGIN";echo $init;echo "V115D_INIT_END";if {[regexp -nocase {Error:|scan chain interrogation failed|IR capture error|dtmcontrol is 0|unable to find CMSIS-DAP} $init]} {error "OPENOCD_INIT_ERROR"};if {[jtag names] ne "riscv.cpu"||![regexp -nocase {0x1e200a6f} $init]} {error "TAP_IDCODE_MISMATCH"};if {![regexp -- {07000001006700343500000a4e57354aa5a5a5a597969908} $init]} {error "DAPLINK_SERIAL_MISMATCH"}
 set cpu [riscv.cpu curstate];echo "V115D_CPU_INITIAL=$cpu";if {$cpu eq "running"} {capture {halt 2000};incr ::v115d_hc;set cpu [riscv.cpu curstate]};echo "V115D_CPU_FINAL=$cpu";if {$cpu ne "halted"||$::v115d_hc>1} {error "CPU_NOT_HALTED"};set dm [v115d_dr 0x11];echo [format "V115D_DMSTATUS=0x%08X" $dm];if {($dm&0x300)!=0x300||($dm&0xC00)!=0} {error "DMSTATUS_NOT_HALTED"};v115d_sb PREFLIGHT
 foreach {label a exp} {PERI_CLKEN 0x4002180C 0x21 PERI_RST 0x40021810 0 GPIOB_ODR 0x40000100 0xC GPIOB_DIR 0x40000104 0xC GPIOB_OSOD 0x40000158 0xC GPIOB_AFR1 0x40000168 0x6C0 GPIOB_IDR 0x40000150 0x2C MODULE_CTRL 0x40002800 2 FIFO_STA 0x4000280C 5 STATUS 0x4000283C 0 RAW_INTR 0x40002858 0} {set got [v115d_rd $a $label];if {$got!=$exp} {error "PRECONDITION_MISMATCH $label expected=[format 0x%08X $exp] got=[format 0x%08X $got]"}}
 set div0_pre [v115d_rd 0x40002810 CLK_DIV0_PRE];set div1_pre [v115d_rd 0x40002814 CLK_DIV1_PRE];echo [format "V115D_DIVIDERS_BEFORE DIV0=0x%08X DIV1=0x%08X" $div0_pre $div1_pre]
 # ARM I2C_MasterInit order and values: H=L=1000, API stores H-1/L-1; HOLD=5; STOP_MODE=SCL_L; 7-bit mode.
 v115d_wr 0x40002810 0x000003E7 CLK_DIV0_H1000_MINUS1
 v115d_wr 0x40002814 0x000003E7 CLK_DIV1_L1000_MINUS1
 v115d_wr 0x40002828 0x00000000 MCTR_7BIT_SCL_L
 v115d_wr 0x40002838 0x00000005 HOLD_5
 v115d_wr 0x40002800 0x0000000C FIFO_ENABLE_I2C_EN_OFF
 v115d_wr 0x40002820 0x00000001 MASTER_MODE
 v115d_wr 0x40002824 0x0000003C OLED_7BIT_ADDR
 set mod0 [v115d_rd 0x40002800 MODULE_BEFORE_I2C_EN];if {($mod0&0xD)!=0xC} {error "FIFO_ENABLE_OR_I2C_EN_PRECONDITION_FAIL"}
 v115d_wr 0x40002800 0x0000000D I2C_EN_AFTER_MODE_AND_ADDR
 set mod1 [v115d_rd 0x40002800 MODULE_AFTER_I2C_EN];set addr1 [v115d_rd 0x40002824 ADDR_AFTER_I2C_EN];if {($mod1&0xD)!=0xD||$addr1!=0x3C} {error "ARM_ORDER_ENABLE_VERIFY_FAIL"}
 # One payload byte only. Never read TX_FIFO; observe count/status/raw instead.
 v115d_sb TX_FIFO_PRE;v115d_dw 0x38 0x20040404 TX_FIFO_WRMODE;v115d_sb TX_FIFO_WRMODE_IDLE;v115d_dw 0x39 0x40002808 TX_FIFO_ADDRESS;v115d_sb TX_FIFO_ADDRESS_IDLE;incr ::v115d_wc;echo [format "V115D_TARGET_MMIO_WRITE_ATTEMPT addr=0x40002808 value=0x00000000 count=%d label=ONE_PAYLOAD_BYTE" $::v115d_wc];v115d_dw 0x3C 0x00000000 ONE_PAYLOAD_BYTE
 set seen_data 0;set drained 0;set nack 0;set lastst 0;set lastfs 0;set lastraw 0
 for {set i 0} {$i<60} {incr i} {set lastst [v115d_rd 0x4000283C "POLL_STATUS_$i"];set lastfs [v115d_rd 0x4000280C "POLL_FIFO_$i"];set lastraw [v115d_rd 0x40002858 "POLL_RAW_$i"];if {$lastst&2} {set seen_data 1};if {$lastraw&0x2000} {set nack 1};echo [format "V115D_POLL i=%d status=0x%08X fifo=0x%08X raw=0x%08X" $i $lastst $lastfs $lastraw];if {(($lastfs>>8)&0xF)==0} {set drained 1};if {$nack||($seen_data&&$drained)} {break};sleep 2}
 if {$nack} {set ::v115d_status "FAIL_NACK_STOP_PENDING";v115d_wr 0x40002828 0x00000002 SINGLE_STOP_AFTER_NACK;incr ::v115d_stop_count} elseif {$seen_data&&$drained} {set ::v115d_status "PASS_TX_CONSUMED_DATA_SEEN_STOP_PENDING";v115d_wr 0x40002828 0x00000002 SINGLE_STOP_AFTER_DATA_DRAIN;incr ::v115d_stop_count} elseif {$drained} {set ::v115d_status "UNKNOWN_FIFO_EMPTY_DATA_NOT_SEEN"} else {set ::v115d_status "FAIL_TX_STALLED_NO_DATA_NO_NACK"}
 if {$::v115d_stop_count>0} {for {set j 0} {$j<40} {incr j} {set lastst [v115d_rd 0x4000283C "STOP_STATUS_$j"];set lastraw [v115d_rd 0x40002858 "STOP_RAW_$j"];echo [format "V115D_STOP_POLL j=%d status=0x%08X raw=0x%08X" $j $lastst $lastraw];if {($lastst&1)==0} {if {$::v115d_status eq "PASS_TX_CONSUMED_DATA_SEEN_STOP_PENDING"} {set ::v115d_status "PASS_TX_CONSUMED_STOP_IDLE"} elseif {$::v115d_status eq "FAIL_NACK_STOP_PENDING"} {set ::v115d_status "FAIL_NACK_STOP_IDLE"};break};sleep 2}}
 set finalmod [v115d_rd 0x40002800 FINAL_MODULE];set finaladdr [v115d_rd 0x40002824 FINAL_ADDR];set finalfifo [v115d_rd 0x4000280C FINAL_FIFO];set finalst [v115d_rd 0x4000283C FINAL_STATUS];set finalraw [v115d_rd 0x40002858 FINAL_RAW];echo [format "V115D_FINAL module=0x%08X addr=0x%08X fifo=0x%08X status=0x%08X raw=0x%08X seen_data=%d drained=%d nack=%d" $finalmod $finaladdr $finalfifo $finalst $finalraw $seen_data $drained $nack]
} err];if {$rc} {set ::v115d_status "FAIL_OR_UNKNOWN";echo "V115D_ERROR=$err"};set sbrc [catch {v115d_sb FINAL} sbv];echo [format "V115D_FINAL_SBCS rc=%d value=%s" $sbrc $sbv];set dmrc [catch {v115d_dr 0x11} dmv];echo [format "V115D_FINAL_DMSTATUS rc=%d value=%s" $dmrc $dmv];echo [format "V115D_RESULT=%s HALT_COUNT=%d TARGET_MMIO_WRITE_COUNT=%d STOP_WRITE_COUNT=%d" $::v115d_status $::v115d_hc $::v115d_wc $::v115d_stop_count];echo "V115D_COMPLETE";shutdown
